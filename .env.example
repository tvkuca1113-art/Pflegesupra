# Public base URL. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://supra-pd.de"

# Supabase — the inquiry store.
# Only the PUBLISHABLE key is used, and only from the server-side route handler.
# The service-role key is deliberately NOT used anywhere in this application:
# writes go through the SECURITY DEFINER function public.supra_submit_inquiry,
# which can insert but can never read. That means a leak of anything in this
# deployment cannot expose stored personal data.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Salt for hashing caller IPs before they are used for throttling.
# Generate with: openssl rand -hex 32
# Rotating it resets throttling counters; it is never stored anywhere else.
INQUIRY_IP_SALT=""

# Optional. Set a GA4 measurement ID to switch on analytics. While this is
# empty the site sets no cookies at all and the consent banner stays hidden,
# because there is nothing to consent to.
NEXT_PUBLIC_GA_ID=""
